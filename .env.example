# Optional. The app runs fully without any of these.
# Without a provider the assistant shows an honest "no AI provider" state plus
# deterministic summaries generated from the computed plan.

# Path to the source workbook (default: ./Atlas_Fresh_Production_Commercial_Data.xlsx)
# WORKBOOK_PATH=

# --- Assistant model (explanation only; never used for planning) ---
# DeepSeek (hosted). Put your key in .env, which git ignores. Never commit it.
# A DEEPSEEK_API_KEY alone switches DeepSeek on; LLM_PROVIDER=deepseek is optional.
# DEEPSEEK_API_KEY=
# LLM_MODEL=deepseek-flash          # optional; default deepseek-flash. Also available: deepseek-v4-pro

# Or any OpenAI-compatible endpoint, e.g. a free local Ollama model:
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://localhost:11434/v1   # Ollama, Groq, OpenRouter, ...
# LLM_API_KEY=                      # not needed for local Ollama

# LLM_TIMEOUT_MS=15000              # optional; default 30000
